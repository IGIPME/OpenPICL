# Logto OIDC (Traditional Web app `17trhj5ohcsqrgh6ht241` on tenant `ufrjei`).
# Copy to .env for local dev. In production these are set as Zeabur env vars.
LOGTO_ENDPOINT=https://ufrjei.logto.app
LOGTO_APP_ID=17trhj5ohcsqrgh6ht241
LOGTO_APP_SECRET=replace-with-real-secret-from-logto-console
# For local dev (leptos binds 127.0.0.1:3000). In prod use:
#   LOGTO_REDIRECT_URI=https://open-picl.zeabur.app/callback
#   LOGTO_POST_LOGOUT_URI=https://open-picl.zeabur.app
LOGTO_REDIRECT_URI=http://localhost:3000/callback
LOGTO_POST_LOGOUT_URI=http://localhost:3000